{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-template",
		"version": "1.0.8"
	},
	"paths": {
		"/mia-template/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getDescriptor",
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-template/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getStatus",
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [ "ENABLED", "INITIALIZED" ]
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-template/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-template/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-template/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"PluginName": {
				"type": "string"
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"EventPluginInitialized": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "initialized" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"EventPluginReleased": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "released" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"EventPluginError": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "released" ]
					},
					"data": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
